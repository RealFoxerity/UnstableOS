# UnstableOS fstab format:
# file     mountpoint     type     ro/rw

# only 'file\ space' syntax is allowed, quotes won't be resolved
# \ is only handled specially if it precedes a space, otherwise normally
# for actual spaces after \ do 'file\\ /mnt' (mounts file\ at /mnt)

# filesystems not requiring a file will always report 'none' in /proc/mounts

